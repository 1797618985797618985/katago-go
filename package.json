{
  "name": "katago-go",
  "version": "1.2.3",
  "private": true,
  "productName": "围棋对战",
  "description": "基于 KataGo 的围棋对战程序：人机对战（级位/段位难度）与人人对战，可完全离线运行，并为实体电驱棋盘预留驱动接口",
  "keywords": [
    "go",
    "weiqi",
    "baduk",
    "katago",
    "gtp",
    "board-game",
    "mcts",
    "offline"
  ],
  "author": "Mo_cun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MocunPrime/katago-go.git"
  },
  "homepage": "https://github.com/MocunPrime/katago-go#readme",
  "bugs": {
    "url": "https://github.com/MocunPrime/katago-go/issues"
  },
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "app": "electron .",
    "dev": "electron . --dev",
    "server": "node server/index.js",
    "icon": "node tools/make-icon.js",
    "screenshot": "electron . --screenshot=docs/screenshot.png",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "test": "node tools/check-version.js && node tools/rules-test.js && node tools/engine-test.js",
    "test:api": "node tools/api-test.js",
    "smoke": "node tools/gtp-smoke.js",
    "mock-board": "node tools/mock-board.js",
    "fetch-engine": "pwsh -NoProfile -File tools/fetch-engine.ps1"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32",
    "linux",
    "darwin"
  ],
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mocunprime.katagogo",
    "productName": "围棋对战",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "server/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "**/*",
          "!_download{,/**}",
          "logs{,/**}"
        ]
      }
    ],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "portable": {
      "artifactName": "katago-go-${version}-portable.exe",
      "unpackDirName": "katago-go"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "katago-go-${version}-setup.exe",
      "shortcutName": "围棋对战"
    },
    "compression": "normal"
  }
}
